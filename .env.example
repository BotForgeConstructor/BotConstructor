# Required: create a Telegram bot with BotFather and replace these placeholders.
BOT_TOKEN=replace_with_your_telegram_bot_token
BOT_USERNAME=replace_with_your_bot_username

# Local application and database ports exposed on the host.
APP_PORT=8080
POSTGRES_PORT=5433

# Safe local-development database defaults; change them if needed.
POSTGRES_DB=bot_constructor
POSTGRES_USER=bot_constructor
POSTGRES_PASSWORD=local_dev_password

# Optional JVM tuning passed to the container's java process.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
