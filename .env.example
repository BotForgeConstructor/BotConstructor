# Optional for local development. Keep disabled for a test-safe startup.
APP_TELEGRAM_MANAGEMENT_ENABLED=false
APP_TELEGRAM_MANAGEMENT_CONNECTION_MODE=LONG_POLLING
APP_TELEGRAM_MANAGEMENT_TOKEN=replace_with_local_development_token
APP_TELEGRAM_MANAGEMENT_USERNAME=replace_with_local_development_username
APP_WEB_URL=http://localhost:5173

# Generate a unique Base64-encoded value containing at least 32 random bytes.
# Never reuse the Telegram bot token as this key.
APP_SESSION_SIGNING_KEY=replace_with_base64_encoded_32_byte_local_key
APP_SESSION_ISSUER=https://bot-constructor.local.invalid
APP_SESSION_AUDIENCE=bot-constructor-api
APP_SESSION_TTL=15m
APP_AUTH_TELEGRAM_MAX_INIT_DATA_AGE=5m
APP_AUTH_TELEGRAM_ALLOWED_FUTURE_SKEW=30s
APP_BOT_CREDENTIAL_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
APP_BOT_CREDENTIAL_ENCRYPTION_KEY_ID=v1
APP_TELEGRAM_MINI_APP_URL=https://replace-with-public-mini-app.example
APP_TELEGRAM_MANAGEMENT_WEBHOOK_SECRET=replace-with-random-webhook-secret
APP_TELEGRAM_MANAGEMENT_WEBHOOK_PATH=/api/v1/telegram/management/webhook
APP_BOT_WEBHOOK_BASE_URL=https://replace-with-public-api.example/api/v1/telegram/webhooks
APP_TELEGRAM_API_BASE_URL=https://api.telegram.org
APP_TELEGRAM_API_CONNECT_TIMEOUT=3s
APP_TELEGRAM_API_READ_TIMEOUT=5s

# Local application and database ports exposed on the host.
APP_PORT=8080
POSTGRES_PORT=5433

# Safe local-development database defaults; change them if needed.
POSTGRES_DB=bot_constructor
POSTGRES_USER=bot_constructor
POSTGRES_PASSWORD=local_dev_password

# Optional JVM tuning passed to the container's java process.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
