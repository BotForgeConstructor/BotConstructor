# Optional for local development. Keep disabled for a test-safe startup.
APP_TELEGRAM_MANAGEMENT_ENABLED=false
APP_TELEGRAM_MANAGEMENT_CONNECTION_MODE=LONG_POLLING
APP_TELEGRAM_MANAGEMENT_TOKEN=replace_with_local_development_token
APP_TELEGRAM_MANAGEMENT_USERNAME=replace_with_local_development_username
APP_WEB_URL=http://localhost:5173

# Local application and database ports exposed on the host.
APP_PORT=8080
POSTGRES_PORT=5433

# Safe local-development database defaults; change them if needed.
POSTGRES_DB=bot_constructor
POSTGRES_USER=bot_constructor
POSTGRES_PASSWORD=local_dev_password

# Optional JVM tuning passed to the container's java process.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
